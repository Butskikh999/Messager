<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Messager.Desktop.Views.LoginView">
    <DockPanel>
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center">
            <TextBox Width="200" Watermark="Login"
                     Margin="0,5,0,5"
                     x:Name="numericWatermark" />
            <TextBox Width="200"
                     Watermark="Password"
                     Classes="revealPasswordButton"
                     UseFloatingWatermark="True"
                     PasswordChar="*"
                     Text="Password" />
            <Button HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Margin="0,5,0,5"
                    Background="DodgerBlue">Login</Button>
            <Button HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Foreground="White">Create a new account</Button>
            <TextBlock Text="Error Message"
                       Margin="5"
                       HorizontalAlignment="Center" 
                       Foreground="IndianRed" 
                       FontSize="18" />
        </StackPanel>
    </DockPanel>
</UserControl>
